# ─── JSearch (aggregates LinkedIn, Indeed, Glassdoor & more) ─────────────────
# Get your free key at: https://app.openwebninja.com/api/jsearch
JSEARCH_API_KEY="your_jsearch_api_key_here"

# Hugging Face API token from: https://huggingface.co/settings/tokens
# Create a token with 'repo.content.read' permission
HF_API_KEY="your_hf_api_token_here"

# ─── Optional ────────────────────────────────────────────────
# Hugging Face model to use (default: huggingface/meta-llama/Llama-3.1-8B-Instruct)
HF_MODEL="huggingface/meta-llama/Llama-3.1-8B-Instruct"

# CrewAI may require an OpenAI key to be set (even if unused).
# Leave as "NA" if you're only using Hugging Face.
OPENAI_API_KEY="NA"
